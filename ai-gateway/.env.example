# ==============================================================================
# CẤU HÌNH AI GATEWAY ("QUÁN NET AI")
# Copy file này thành .env và chỉnh sửa theo nhu cầu: cp .env.example .env
# ==============================================================================

# 1. Cấu hình Upstream (Backend thật - Google Colab chạy llama.cpp server)
# Domain tĩnh ngrok miễn phí trỏ tới llama-server (có kèm /v1 ở cuối)
UPSTREAM_BASE_URL=https://ten-domain-cua-toi.ngrok-free.app/v1

# API Key của upstream nếu có cấu hình --api-key trên llama-server (để trống nếu không dùng)
UPSTREAM_API_KEY=

# 2. Mật khẩu đăng nhập Admin Panel (CHỈ MÌNH BẠN BIẾT)
# Dùng để đăng nhập vào giao diện web http://<ip-vps>:8000/admin
ADMIN_PASSWORD=admin123456

# Khóa bí mật ký phiên đăng nhập admin (để trống hệ thống sẽ tự sinh ngẫu nhiên khi khởi động)
SECRET_KEY=doi_thanh_chuoi_ngau_nhien_dai_32_ky_tu_bao_mat_hon

# 3. Đường dẫn lưu cơ sở dữ liệu SQLite
DB_PATH=data/gateway.db

# 4. Giới hạn tốc độ (Rate Limit) tránh spam (số request tối đa mỗi phút trên 1 key)
RATE_LIMIT_PER_MINUTE=60

# 5. Cấu hình thời gian chờ kết nối (Timeout tính bằng giây)
CONNECT_TIMEOUT=10.0
READ_TIMEOUT=300.0

# 6. Cấu hình mạng máy chủ
HOST=0.0.0.0
PORT=8000
